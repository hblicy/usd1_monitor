[Unit]
Description=USD1 Read-Only Risk Dashboard
After=usd1-monitor.service

[Service]
Type=simple
User=usd1-monitor
Group=usd1-monitor
WorkingDirectory=/opt/usd1-monitor
EnvironmentFile=/etc/usd1-monitor.env
ExecStart=/opt/usd1-monitor/.venv/bin/python -m usd1_monitor --config /etc/usd1-monitor.yaml dashboard
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/usd1-monitor

[Install]
WantedBy=multi-user.target
